---
import Icon from './Icon.astro';
---

<div
  class="cart-drawer"
  data-cart-drawer
  role="dialog"
  aria-modal="true"
  aria-label="Carrito de compras"
>
  <div class="cart-drawer__overlay" data-cart-close></div>

  <aside class="cart-drawer__panel">
    <header class="cart-drawer__head">
      <h2 class="cart-drawer__title">
        Tu carrito
        <span
          style="font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)"
          data-cart-open-label
        >
          0 productos
        </span>
      </h2>
      <button class="icon-btn" type="button" data-cart-close aria-label="Cerrar carrito">
        <Icon name="close" size={22} />
      </button>
    </header>

    <div class="cart-drawer__body" data-cart-body></div>

    <footer class="cart-drawer__foot" data-cart-foot></footer>
  </aside>
</div>
