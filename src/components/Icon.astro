---

<svg
  xmlns="http://www w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={fill ? 'currentColor': 'none'}
  stroke={fill ? 'none': 'currentColor'}
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
  set:html={paths[name] ?? ''}
/>
