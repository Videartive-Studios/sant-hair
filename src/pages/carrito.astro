---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Tu carrito"
  description="Revisa los productos de Sant Hair+ que elegiste antes de completar tu pedido."
  noindex
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Migas de pan">
      <a href="/">Inicio</a>
      <span>/</span>
      <span aria-current="page">Carrito</span>
    </nav>
  </div>

  <section class="section" style="padding-top:1rem">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Tu selección</p>
          <h1 class="display-2">Carrito de compras</h1>
        </div>
        <a class="btn btn--light btn--sm" href="/tienda">Seguir comprando</a>
      </div>

      <div class="split" style="align-items:start;gap:clamp(2rem,4vw,3rem)">
        <div>
          <div data-cart-page-items>
            <div class="summary-card text-center" style="padding:3rem 1.5rem">
              <p style="color:var(--muted)">Cargando tu carrito...</p>
            </div>
          </div>
        </div>

        <aside class="summary-card" data-cart-page-summary>
          <h2 class="summary-card__title">Resumen del pedido</h2>
          <p style="color:var(--muted);font-size:.9rem">Agrega productos para ver el total.</p>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    getCart,
    cartTotals,
    formatMoney,
    getPromoCode,
    setPromoCode,
    clearPromoCode,
  } from '@/scripts/cart';
  import { escapeHtml, safeImageSrc } from '@/lib/escape';

  const itemsEl = document.querySelector<HTMLElement>('[data-cart-page-items]');
  const summaryEl = document.querySelector<HTMLElement>('[data-cart-page-summary]');

  function render() {
    if (!itemsEl || !summaryEl) return;

    const items = getCart();

    if (items.length === 0) {
      itemsEl.innerHTML = `
        <div class="summary-card text-center" style="padding:3.5rem 1.5rem">
          <h2 class="summary-card__title">Tu carrito está vacío</h2>
          <p style="color:var(--muted)">
            Todavía no has agregado productos. Te esperamos en la tienda.
          </p>
          <a class="btn" href="/tienda" style="margin-top:1.5rem">Explorar la tienda</a>
        </div>`;
      summaryEl.innerHTML = '';
      return;
    }

    itemsEl.innerHTML = items
      .map(
        (item) => `
        <div class="cart-line" data-slug="${escapeHtml(item.slug)}" style="background:#fff;border:1px solid var(--line);padding:1.25rem;margin-bottom:.75rem">
          <a class="cart-line__img" href="/tienda/${encodeURIComponent(item.slug)}">
            <img src="${safeImageSrc(item.image)}" alt="${escapeHtml(item.name)}" width="80" height="80" loading="lazy" />
          </a>
          <div>
            <a class="cart-line__name" href="/tienda/${encodeURIComponent(item.slug)}">${escapeHtml(item.name)}</a>
            <div class="cart-line__meta">${escapeHtml(item.size)} &middot; ${formatMoney(item.price)} c/u</div>
            <div class="qty" style="margin-top:.6rem">
              <button type="button" data-cart-decrease aria-label="Restar una unidad">&minus;</button>
              <input type="number" value="${item.qty}" min="1" max="99" data-cart-qty aria-label="Cantidad" />
              <button type="button" data-cart-increase aria-label="Sumar una unidad">+</button>
            </div>
            <button type="button" class="cart-line__remove" data-cart-remove style="margin-top:.5rem">
              Quitar del carrito
            </button>
          </div>
          <div class="cart-line__price">${formatMoney(item.price * item.qty)}</div>
        </div>`,
      )
      .join('');

    const {
      subtotal,
      discount,
      promo,
      shipping,
      total,
      freeShippingRemaining,
      count,
    } = cartTotals(items);
    const progress = Math.min(100, (subtotal / 150_000) * 100);

    summaryEl.innerHTML = `
      <h2 class="summary-card__title">Resumen del pedido</h2>
      <div class="cart-progress"><div class="cart-progress__bar" style="width:${progress}%"></div></div>
      ${
        freeShippingRemaining > 0
          ? `<p style="font-size:.82rem;color:var(--muted);margin-bottom:1rem">Te faltan <strong style="color:var(--gold-deep)">${formatMoney(freeShippingRemaining)}</strong> para el envío gratis</p>`
          : `<p style="font-size:.82rem;color:var(--ok);margin-bottom:1rem">Tienes envío gratis aplicado</p>`
      }
      <div class="cart-summary"><span>Productos (${count})</span><span>${formatMoney(subtotal)}</span></div>
      ${
        discount > 0
          ? `<div class="cart-summary" style="color:var(--ok)"><span>Descuento ${escapeHtml(promo?.code ?? '')}</span><span>-${formatMoney(discount)}</span></div>`
          : ''
      }
      <div class="cart-summary"><span>Envío</span><span>${shipping === 0 ? 'Gratis' : formatMoney(shipping)}</span></div>
      <div class="cart-summary cart-summary--total"><span>Total</span><span>${formatMoney(total)}</span></div>
      <div style="display:flex;gap:.5rem;margin-top:1rem">
        <input class="input" type="text" placeholder="Código de descuento" data-cart-promo
          value="${escapeHtml(getPromoCode())}" style="text-transform:uppercase" autocomplete="off" spellcheck="false" />
        <button class="btn btn--light" type="button" data-cart-promo-apply>Aplicar</button>
      </div>
      <p style="font-size:.78rem;color:var(--muted);margin-top:.5rem" data-cart-promo-message>
        ${discount > 0 ? `Código ${escapeHtml(promo?.code ?? '')} aplicado.` : 'El descuento se aplica sobre el subtotal.'}
      </p>
      <a class="btn btn--gold btn--block" href="/checkout" style="margin-top:1.25rem">
        Finalizar compra
      </a>
      <p style="font-size:.78rem;color:var(--muted);text-align:center;margin-top:.85rem">
        Pago seguro &middot; Envío a todo el país
      </p>`;

    // Boton de aplicar cupon: se crea cada vez que se redibuja el resumen.
    const promoBtn = summaryEl.querySelector<HTMLButtonElement>('[data-cart-promo-apply]');
    const promoInput = summaryEl.querySelector<HTMLInputElement>('[data-cart-promo]');
    promoBtn?.addEventListener('click', () => {
      const code = promoInput?.value ?? '';
      if (!code.trim()) {
        clearPromoCode();
        render();
        return;
      }
      setPromoCode(code);
      render();
    });
  }

  render();
  document.addEventListener('santhair:cart:updated', render);
</script>
