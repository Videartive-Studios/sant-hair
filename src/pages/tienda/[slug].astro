---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/ProductCard.astro';
import Icon from '@/components/Icon.astro';
import { getProduct, getPublishedProducts } from '@/db/repo';
import { SITE } from '@/data/site';
import { breadcrumbSchema, productSchema } from '@/lib/seo';
import { img } from '@/lib/assets';

const { slug } = Astro.params;
const product = slug ? await getProduct(slug) : undefined;

// Un producto que no existe es un 404 real, no una redireccion: el
// buscador no debe indexar la pagina de error ni perder la URL original.
// `Astro.rewrite` renderiza la pagina de error conservando la URL pedida.
if (!product || product.published === false) {
  return Astro.rewrite('/404');
}

const related = (await getPublishedProducts())
  .filter((p) => p.slug !== product.slug)
  .slice(0, 3);

const formatMoney = (value: number) =>
  new Intl.NumberFormat('es-CO', {
    style: 'currency',
    currency: SITE.currency,
    maximumFractionDigits: 0,
  }).format(value);

const discount = product.compareAtPrice
  ? Math.round((1 - product.price / product.compareAtPrice) * 100)
  : 0;

const outOfStock = product.stock <= 0;

const breadcrumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Tienda', href: '/tienda' },
  { name: product.name, href: `/tienda/${product.slug}` },
];
---

<BaseLayout
  title={product.seoTitle}
  description={product.seoDescription}
  image={img(product.image)}
  ogType="product"
  schema={[productSchema(product), breadcrumbSchema(breadcrumbs)]}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Migas de pan">
      <a href="/">Inicio</a>
      <span>/</span>
      <a href="/tienda">Tienda</a>
      <span>/</span>
      <span aria-current="page">{product.name}</span>
    </nav>
  </div>

  <section class="section" style="padding-top:1rem">
    <div class="container">
      <div class="pdp">
        <!-- ============ GALERÍA ============ -->
        <div class="pdp__gallery">
          <div class="pdp__main">
            <img
              id="pdp-main-image"
              src={img(product.gallery[0])}
              alt={`${product.name} Sant Hair+ ${product.size}`}
              width="800"
              height="800"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          {
            product.gallery.length > 1 && (
              <div class="pdp__thumbs">
                {product.gallery.map((image, index) => (
                  <button
                    class={`pdp__thumb ${index === 0 ? 'is-active' : ''}`}
                    type="button"
                    data-gallery-thumb={image}
                    aria-label={`Ver imagen ${index + 1} de ${product.name}`}
                  >
                    <img src={img(image)} alt="" width="78" height="78" loading="lazy" />
                  </button>
                ))}
              </div>
            )
          }
        </div>

        <!-- ============ INFORMACIÓN ============ -->
        <div class="stack stack-3">
          <div>
            <p class="eyebrow">{product.subtitle}</p>
            <h1 class="display-2" style="margin:.5rem 0.75rem">{product.name}</h1>
            <p class="lede">{product.shortDescription}</p>
          </div>

          <div class="cluster" style="gap:1rem">
            <p class="pdp__price">
              {formatMoney(product.price)}
              {product.compareAtPrice && <del>{formatMoney(product.compareAtPrice)}</del>}
            </p>
            {discount > 0 && <span class="pdp__save">-{discount}%</span>}
          </div>

          <p style="font-size:.85rem;color:var(--muted)">
            {product.size} &middot;{' '}
            {outOfStock
              ? 'Sin unidades disponibles'
              : product.stock <= 10
                ? `Últimas ${product.stock} unidades`
                : 'En stock'}
          </p>

          <div class="cluster" style="gap:.85rem">
            <div class="qty">
              <button type="button" data-qty-minus aria-label="Restar una unidad">
                <Icon name="minus" size={16} />
              </button>
              <input
                type="number"
                value="1"
                min="1"
                max={Math.max(product.stock, 1)}
                data-qty-input
                aria-label="Cantidad"
              />
              <button type="button" data-qty-plus aria-label="Sumar una unidad">
                <Icon name="plus" size={16} />
              </button>
            </div>

            <button
              class="btn btn--gold"
              type="button"
              style="flex:1;min-width:220px"
              data-add-to-cart
              data-slug={product.slug}
              data-name={product.name}
              data-price={product.price}
              data-image={img(product.image)}
              data-size={product.size}
              disabled={outOfStock}
            >
              {outOfStock ? 'Agotado' : 'Agregar al carrito'}
            </button>
          </div>

          <p style="font-size:.82rem;color:var(--muted)">
            <Icon name="truck" size={16} style="display:inline;vertical-align:-3px" />
            {' '}Envío gratis en pedidos superiores a {formatMoney(SITE.freeShippingThreshold)}.
            Entrega en 2 a 5 días hábiles.
          </p>

          <!-- ============ ACORDEÓN ============ -->
          <div class="accordion" style="margin-top:.5rem">
            <details class="accordion__item" open>
              <summary class="accordion__summary">
                Descripción
                <span class="accordion__icon"></span>
              </summary>
              <div class="accordion__content">
                <p>{product.description}</p>
              </div>
            </details>

            <details class="accordion__item">
              <summary class="accordion__summary">
                Beneficios
                <span class="accordion__icon"></span>
              </summary>
              <div class="accordion__content">
                <ul>
                  {product.benefits.map((benefit) => <li>{benefit}</li>)}
                </ul>
              </div>
            </details>

            <details class="accordion__item">
              <summary class="accordion__summary">
                Ingredientes
                <span class="accordion__icon"></span>
              </summary>
              <div class="accordion__content">
                <ul>
                  {product.ingredients.map((ingredient) => <li>{ingredient}</li>)}
                </ul>
              </div>
            </details>

            <details class="accordion__item">
              <summary class="accordion__summary">
                Cómo usarlo
                <span class="accordion__icon"></span>
              </summary>
              <div class="accordion__content">
                <p>{product.howToUse}</p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section section--cream">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">Combina tu rutina</p>
              <h2 class="section-head__title">También te puede interesar</h2>
            </div>
            <a class="link-underline" href="/tienda">Ver todo</a>
          </div>
          <div class="product-grid">
            {related.map((item) => (
              <ProductCard product={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  // Selector de cantidad
  const input = document.querySelector<HTMLInputElement>('[data-qty-input]');
  const max = Number(input?.getAttribute('max') ?? 99);

  document.querySelector('[data-qty-minus]')?.addEventListener('click', () => {
    if (!input) return;
    input.value = String(Math.max(1, Number(input.value) - 1));
  });

  document.querySelector('[data-qty-plus]')?.addEventListener('click', () => {
    if (!input) return;
    input.value = String(Math.min(max, Number(input.value) + 1));
  });

  // Galeria
  const main = document.querySelector<HTMLImageElement>('#pdp-main-image');
  document.querySelectorAll<HTMLElement>('[data-gallery-thumb]').forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const src = thumb.dataset.galleryThumb;
      if (!src || !main) return;
      main.src = src;
      document
        .querySelectorAll('[data-gallery-thumb]')
        .forEach((el) => el.classList.remove('is-active'));
      thumb.classList.add('is-active');
    });
  });
</script>
