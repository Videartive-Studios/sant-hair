---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LEGAL_DOCS, type LegalDoc } from '@/data/legal';
import { breadcrumbSchema } from '@/lib/seo';
import { url } from '@/lib/url';

interface Props {
  /** El documento, solo en la vista previa estatica (llega por `props`). */
  doc?: LegalDoc;
}

/**
 * En el sitio real la ruta se resuelve en el servidor con el slug de la URL.
 * En la vista previa estatica (GitHub Pages) no hay servidor, asi que Astro
 * prerenderiza un archivo por documento y se lo entrega en `props`.
 */
export function getStaticPaths() {
  return LEGAL_DOCS.map((doc) => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

const { slug } = Astro.params;
const doc = Astro.props.doc ?? LEGAL_DOCS.find((d) => d.slug === slug);

// Un documento legal inexistente es un 404 real.
if (!doc) {
  return Astro.rewrite('/404');
}

const formatDate = (value: string) =>
  new Intl.DateTimeFormat('es-CO', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date(`${value}T12:00:00Z`));

const breadcrumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Legal', href: '/legal/privacidad' },
  { name: doc.title, href: `/legal/${doc.slug}` },
];
---

<BaseLayout
  title={doc.title}
  description={doc.intro}
  schema={breadcrumbSchema(breadcrumbs)}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Migas de pan">
      <a href={url('/')}>Inicio</a>
      <span>/</span>
      <span aria-current="page">{doc.title}</span>
    </nav>
  </div>

  <section class="section" style="padding-top:1rem">
    <div class="container container--narrow">
      <div class="stack stack-3">
        <div class="stack stack-2">
          <p class="eyebrow">Legal</p>
          <h1 class="display-2">{doc.title}</h1>
          <p class="lede">{doc.intro}</p>
          <p style="font-size:.8rem;color:var(--muted)">
            Última actualización: {formatDate(doc.updated)}
          </p>
        </div>

        <div class="prose">
          {
            doc.sections.map((section) => (
              <>
                <h2>{section.heading}</h2>
                {section.body.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </>
            ))
          }
        </div>

        <div class="summary-card">
          <h2 class="summary-card__title">¿Alguna duda?</h2>
          <p style="color:var(--muted);font-size:.93rem">
            Escríbenos y te ayudamos. Respondemos en menos de 24 horas hábiles.
          </p>
          <a class="btn btn--light" href={url('/contacto')} style="margin-top:1.25rem">
            Ir a contacto
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
