---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BLOG_POSTS } from '@/data/content';
import { breadcrumbSchema } from '@/lib/seo';
import { imgSrc } from '@/lib/assets';
import { url } from '@/lib/url';

const formatDate = (value: string) =>
  new Intl.DateTimeFormat('es-CO', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date(`${value}T12:00:00Z`));

const breadcrumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Blog', href: '/blog' },
];
---

<BaseLayout
  title="Blog de cuidado capilar | Sant Hair+"
  description="Consejos de cuidado capilar, guías de rutina y artículos sobre ingredientes, el equipo de Sant Hair+."
  schema={breadcrumbSchema(breadcrumbs)}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Migas de pan">
      <a href={url('/')}>Inicio</a>
      <span>/</span>
      <span aria-current="page">Blog</span>
    </nav>
  </div>

  <section class="section" style="padding-top:1rem">
    <div class="container">
      <div class="section-head section-head--center">
        <div>
          <p class="eyebrow">Ideas y guías</p>
          <h1 class="display-2">El blog</h1>
          <p class="lede" style="text-align:center">
            Todo lo que aprendemos del cuidado capilar, explicado sin vueltas.
          </p>
        </div>
      </div>

      <div class="post-grid">
        {
          BLOG_POSTS.map((post) => (
            <article class="post-card">
              <a class="post-card__media" href={url(`/blog/${post.slug}`)}>
                <img
                  src={imgSrc(post.cover)}
                  alt={post.title}
                  width="1200"
                  height="750"
                  loading="lazy"
                />
              </a>
              <div class="post-card__meta">
                <span>{post.category}</span>
                <span>{formatDate(post.date)}</span>
                <span>{post.readTime}</span>
              </div>
              <h2 class="post-card__title">
                <a href={url(`/blog/${post.slug}`)}>{post.title}</a>
              </h2>
              <p style="color:var(--text-2);font-size:.95rem">{post.excerpt}</p>
              <a class="link-underline" href={url(`/blog/${post.slug}`)} style="margin-top:.85rem">
                Leer artículo
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
