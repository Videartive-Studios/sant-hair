---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { BLOG_POSTS, type BlogPost } from '@/data/content';
import { articleSchema, breadcrumbSchema } from '@/lib/seo';
import { img, imgSrc } from '@/lib/assets';
import { url } from '@/lib/url';

interface Props {
  /** El articulo, solo en la vista previa estatica (llega por `props`). */
  post?: BlogPost;
}

/**
 * En el sitio real la ruta se resuelve en el servidor con el slug de la URL.
 * En la vista previa estatica (GitHub Pages) no hay servidor, asi que Astro
 * prerenderiza un archivo por articulo y se lo entrega en `props`.
 */
export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { slug } = Astro.params;
const post = Astro.props.post ?? BLOG_POSTS.find((p) => p.slug === slug);

// Un articulo inexistente es un 404 real, no una redireccion a /blog.
if (!post) {
  return Astro.rewrite('/404');
}

const others = BLOG_POSTS.filter((p) => p.slug !== post.slug).slice(0, 2);

const formatDate = (value: string) =>
  new Intl.DateTimeFormat('es-CO', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date(`${value}T12:00:00Z`));

const breadcrumbs = [
  { name: 'Inicio', href: '/' },
  { name: 'Blog', href: '/blog' },
  { name: post.title, href: `/blog/${post.slug}` },
];
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  image={img(post.cover)}
  ogType="article"
  schema={[articleSchema(post), breadcrumbSchema(breadcrumbs)]}
>
  <div class="container">
    <nav class="breadcrumb" aria-label="Migas de pan">
      <a href={url('/')}>Inicio</a>
      <span>/</span>
      <a href={url('/blog')}>Blog</a>
      <span>/</span>
      <span aria-current="page">{post.title}</span>
    </nav>
  </div>

  <article class="section" style="padding-top:1rem">
    <div class="container container--narrow">
      <header class="stack stack-2" style="margin-bottom:2.5rem">
        <div class="post-card__meta">
          <span>{post.category}</span>
          <span>{formatDate(post.date)}</span>
          <span>{post.readTime} de lectura</span>
        </div>
        <h1 class="display-2 balance">{post.title}</h1>
        <p class="lede">{post.excerpt}</p>
        <p style="font-size:.82rem;color:var(--muted)">
          Por {post.author}
        </p>
      </header>

      <div class="ratio-4-3 ratio-4-3--contain" style="margin-bottom:2.5rem">
        <img
          src={imgSrc(post.cover)}
          alt={post.title}
          width="1200"
          height="750"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div class="prose">
        {post.content.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <div
        class="summary-card"
        style="margin-top:3rem;display:flex;gap:1.5rem;align-items:center;flex-wrap:wrap"
      >
        <div style="flex:1;min-width:240px">
          <h2 class="summary-card__title" style="margin-bottom:.4rem">
            Lleva la rutina a casa
          </h2>
          <p style="color:var(--muted);font-size:.92rem">
            Descubre los tres productos de la línea Sant Hair+.
          </p>
        </div>
        <a class="btn" href={url('/tienda')}>Ir a la tienda</a>
      </div>
    </div>
  </article>

  {
    others.length > 0 && (
      <section class="section section--cream">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">Sigue leyendo</p>
              <h2 class="section-head__title">Otros artículos</h2>
            </div>
            <a class="link-underline" href={url('/blog')}>Ver todo</a>
          </div>
          <div class="post-grid">
            {others.map((item) => (
              <article class="post-card">
                <a class="post-card__media" href={url(`/blog/${item.slug}`)}>
                  <img
                    src={imgSrc(item.cover)}
                    alt={item.title}
                    width="1200"
                    height="750"
                    loading="lazy"
                  />
                </a>
                <div class="post-card__meta">
                  <span>{item.category}</span>
                  <span>{formatDate(item.date)}</span>
                </div>
                <h3 class="post-card__title">
                  <a href={url(`/blog/${item.slug}`)}>{item.title}</a>
                </h3>
                <p style="color:var(--text-2);font-size:.95rem">{item.excerpt}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
