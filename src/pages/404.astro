---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { url } from '@/lib/url';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe o fue movida."
  noindex
>
  <section class="section">
    <div class="container container--narrow text-center">
      <p class="eyebrow">Error 404</p>
      <h1 class="display-1" style="margin:.75rem 0 1rem">Esta página no existe</h1>
      <p class="lede" style="text-align:center;margin-inline:auto">
        Puede que el enlace haya cambiado o que la página haya sido movida. Volvamos
        al inicio y encontremos lo que buscas.
      </p>
      <div class="cluster" style="justify-content:center;margin-top:2rem">
        <a class="btn" href={url('/')}>Ir al inicio</a>
        <a class="btn btn--light" href={url('/tienda')}>Ver la tienda</a>
      </div>
    </div>
  </section>
</BaseLayout>
