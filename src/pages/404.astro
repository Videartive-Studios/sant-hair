---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
---

<BaseLayout
  title="Pagina no encontrada"
  description="La pagina que buscas no existe o fue movida."
  noindex
>
  <section class="section">
    <div class="container container--narrow text-center">
      <p class="eyebrow">Error 404</p>
      <h1 class="display-1" style="margin:.75rem 0 1rem">Esta pagina no existe</h1>
      <p class="lede" style="text-align:center;margin-inline:auto">
        Puede que el enlace haya cambiado o que la pagina haya sido movida. Volvamos
        al inicio y encontremos lo que buscas.
      </p>
      <div class="cluster" style="justify-content:center;margin-top:2rem">
        <a class="btn" href="/">Ir al inicio</a>
        <a class="btn btn--light" href="/tienda">Ver la tienda</a>
      </div>
    </div>
  </section>
</BaseLayout>
