# Copia este archivo a .env (o defines las variables en Netlify) y ajusta los valores.

# Contrasena de acceso al panel de administracion (/admin).
# Si no se define, el panel queda deshabilitado.
ADMIN_PASSWORD=cambia-esta-contrasena

# Clave para firmar las cookies de sesion del panel.
# Genera una con: openssl rand -hex 32
ADMIN_SECRET=cambia-este-secreto-por-uno-aleatorio-de-32-caracteres

# Netlify inyecta estas dos automaticamente en el entorno de las Functions.
# Solo son necesarias si ejecutas las Functions fuera de Netlify.
# NETLIFY_BLOBS_SITE_ID=
# NETLIFY_BLOBS_TOKEN=
